# Compose 变量（复制为本目录的 .env；仅用于 docker-compose.yml 的 ${...} 替换，不是应用配置）
#
# 宿主机上发布 8000 端口的绑定地址：填东京主机的 ZeroTier 内网 IP（ip -4 addr show 查看 zt* 网卡），
# 首尔 nginx 通过该地址访问后端。保持默认 127.0.0.1 时只有本机能访问（用于首次自检）。
STOCK_BIND_ADDR=127.0.0.1
# 数据根目录：其下需要有 config/ data/ logs/ reports/ 四个子目录（见 README.md）
STOCK_DEPLOY_ROOT=/data/nex-stock
# 镜像标签（可选）
STOCK_IMAGE_TAG=local
# 容器内存上限（可选）；完整分析建议 2g 以上
STOCK_MEM_LIMIT=2g
