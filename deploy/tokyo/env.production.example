# ===========================================================================
# nex-stock 东京生产配置模板 -> 复制到 /data/nex-stock/config/.env（见 deploy/tokyo/README.md）
# ===========================================================================
# 只列出生产环境需要设置的键名；密钥一律留空，部署时在服务器上填写，切勿提交到仓库。
# 完整说明见仓库根目录 .env.example 与 docs/full-guide.md。
# 容器内路径（DATABASE_PATH / LOG_DIR / ENV_FILE / WEBUI_HOST）由 docker-compose.yml 固定，不要在这里重复设置。

# --- 认证：NexorAI 用户中心（仅管理员） -----------------------------------
AUTH_MODE=user_center
# 浏览器访问本系统的公开地址（协议+域名，不带路径）；需先加入用户中心的返回地址白名单
PUBLIC_ORIGIN=https://stock.nexorai.com.cn
USER_CENTER_URL=https://user.nexorai.com.cn
USER_CENTER_REQUIRED_ROLE=admin
# user_center 模式下不使用本地密码：ADMIN_AUTH_ENABLED 保持 false（或不设置）

# --- 服务 ---------------------------------------------------------------
WEBUI_PORT=8000
# 反向代理（首尔 nginx）后面部署；user_center 模式不依赖客户端 IP，保持默认即可
# TRUST_X_FORWARDED_FOR=false

# --- 行情数据 -------------------------------------------------------------
TUSHARE_TOKEN=
# 自选股（也可以在登录后的设置页维护）
STOCK_LIST=
# 冷启动回填交易日数（docker compose exec 运行 scripts/backfill_market_snapshot.py 时的默认值）
MARKET_SNAPSHOT_BACKFILL_DAYS=60

# --- LLM ----------------------------------------------------------------
# 渠道（LLM_CHANNELS、LLM_<渠道>_API_KEY / _BASE_URL / _MODELS ……）登录后在 Web 设置页「AI 模型」里配置并保存，
# 保存会写入本文件；这里无需预填密钥。可选：
# LLM_REASONING_EFFORT=

# --- 资讯 -----------------------------------------------------------------
# 开启后定时抓取 AKShare 资讯池（交易日 08:00-15:30 轮询，每日早餐/公告在 NEWS_DAILY_FETCH_TIME）
NEWS_INTEL_AUTO_FETCH_ENABLED=true
# NEWS_POLL_INTERVAL_MINUTES=10
# NEWS_POLL_OFFHOURS_INTERVAL_MINUTES=30
# NEWS_DAILY_FETCH_TIME=08:05

# --- 飞书（长连接收消息 + 推送）---------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_STREAM_ENABLED=true
# 推送目标：在会话里发送 /bind 绑定，或填写 FEISHU_CHAT_ID（备用）
# FEISHU_CHAT_ID=

# --- 定时任务（同一进程内的 runtime scheduler）--------------------------------
# compose 里的 --schedule 已强制启用调度；这里同步为 true，保证设置页与实际一致
SCHEDULE_ENABLED=true
# 每日分析时间（HH:MM，容器时区 Asia/Shanghai）
SCHEDULE_TIME=18:00
SCHEDULE_RUN_IMMEDIATELY=false
TRADING_DAY_CHECK_ENABLED=true
# 17:00 板块异动日度流程 + 每周行业成分刷新
BOARD_PIPELINE_ENABLED=true
BOARD_PIPELINE_SCHEDULE_TIME=17:00
BOARD_INDUSTRY_MEMBERSHIP_ENABLED=true
# 08:15 盘前版（隔夜美股 + 自选股分析，约 08:45 送达）
PREOPEN_PUSH_ENABLED=true
PREOPEN_PUSH_TIME=08:15
